# ==============================================================================
# TrustScore AI - Environment Configuration Template
# ==============================================================================
# Instructions:
# Copy this file to '.env' in the loan-ai/ folder and supply your values.
# e.g.: cp .env.example .env (or copy .env.example .env on Windows)
# ==============================================================================

# Flask Session & Application Security Key
SECRET_KEY=trustscore-ai-secret-key-2024-indian-retail-credit

# Anthropic Claude API Key for Generative Advisory (Optional)
# When provided, engine/advisor.py will call model "claude-sonnet-4-6"
# to generate personalized financial counseling.
# If omitted or invalid, the system automatically falls back to the
# built-in rule-based template engine without errors.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
